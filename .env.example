# --- Google OAuth (NextAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=          # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# --- GCP / BigQuery ---
GCP_PROJECT_ID=mis-gempundit
BIGQUERY_LOCATION=asia-south2
# Full service-account JSON as a single-line string
GCP_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- Optional overrides (defaults shown) ---
# Weekly snapshot of the heavy assited_orders_for_verification view (see sql/assisted_orders_snapshot.sql)
ORDERS_VIEW_ID=mis-gempundit.order_verification.assited_orders_for_verification_snapshot
EMPLOYEE_DATA_TABLE_ID=mis-gempundit.gempundit_db.employee
# Sign-in needs employee.Project_id to list this value (comma-separated list supported)
PROJECT_SYSTEM=order_verification
